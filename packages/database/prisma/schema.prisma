generator client {
  provider = "prisma-client-js"
  // Enables per-query `relationLoadStrategy: "join"` — loads relations via LATERAL joins in a single
  // round-trip (with proper LIMIT pushdown) instead of Prisma's default N sequential statements.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          UserRole @default(USER)
  canCreateWorkspace Boolean @default(true)
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationSentAt DateTime?
  passwordResetTokenHash String?
  passwordResetSentAt DateTime?
  name          String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   OrganizationMember[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  teamChatMessages TeamChatMessage[]
  sentInvitations Invitation[] @relation("SentInvitations")
  assignedEscalationThreads EscalationThread[] @relation("AssignedEscalationThread")
  escalationThreadReplies EscalationThreadReply[]
  reviewedKnowledgeSuggestions KnowledgeSuggestion[] @relation("ReviewedKnowledgeSuggestions")
  billingTransactions BillingTransaction[]
  managerProfile ManagerProfile?
  setupRequestsAsRequester WorkspaceSetupRequest[] @relation("WorkspaceSetupRequester")
  setupRequestsAsManager WorkspaceSetupRequest[] @relation("WorkspaceSetupManager")
}

enum UserRole {
  USER
  MANAGER
}

enum ManagerVerificationStatus {
  PENDING
  VERIFIED
  ARCHIVED
}

enum WorkspaceSetupRequestStatus {
  PENDING
  CONTACTED
  ORG_CREATED
  REQUESTER_ADDED
  COMPLETED
  DECLINED
  CANCELED
}

model ManagerProfile {
  id        String                    @id @default(cuid())
  userId    String                    @unique
  displayName String?
  bio       String?
  specialties String[]                @default([])
  status    ManagerVerificationStatus @default(PENDING)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model WorkspaceSetupRequest {
  id          String                      @id @default(cuid())
  requesterId String
  managerId   String
  organizationId String?
  status      WorkspaceSetupRequestStatus @default(PENDING)
  note        String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  requester   User                        @relation("WorkspaceSetupRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  manager     User                        @relation("WorkspaceSetupManager", fields: [managerId], references: [id], onDelete: Cascade)
  organization Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([requesterId, status, createdAt])
  @@index([managerId, status, createdAt])
  @@index([organizationId])
  @@unique([requesterId, managerId, status])
}

// ─── Organizations ────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  bots        Bot[]
  knowledgeFiles KnowledgeFile[]
  conversations  Conversation[]
  integrations   Integration[]
  billing        Billing?
  invitations    Invitation[]
  workspaceJoinCodes WorkspaceJoinCode[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  cannedResponses CannedResponse[]
  teamChatMessages TeamChatMessage[]
  escalationThreads EscalationThread[]
  knowledgeSuggestions KnowledgeSuggestion[]
  aiUsageEvents         AiUsageEvent[]
  registrationProducts  RegistrationProduct[]
  registrationEntries   RegistrationEntry[]
  knowledgeGaps KnowledgeGap[]
  creditLedgerEntries CreditLedger[]
  billingTransactions BillingTransaction[]
  contactEndpoints ContactEndpoint[]
  contactPolicies ContactPolicy[]
  actionTasks ActionTask[]
  actionDeliveries ActionDelivery[]
  leads Lead[]
  bookings Booking[]
  salesOrders SalesOrder[]
  technicalIssues TechnicalIssue[]
  commerceStores CommerceStore[]
  commerceOrders CommerceOrder[]
  setupRequests WorkspaceSetupRequest[]
  commercePayments CommercePayment[]
  customers Customer[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(AGENT)
  createdAt      DateTime @default(now())

  // ── Agent routing metadata ────────────────────────────────────────────────
  // Topic tags this agent handles, e.g. ["billing", "technical", "returns"]
  specializations          String[]  @default([])
  // Agent is accepting new conversations
  isAvailable              Boolean   @default(true)
  // Hard cap on simultaneous open conversations
  maxConcurrentConversations Int     @default(10)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role, isAvailable])
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  token          String           @unique
  role           MemberRole       @default(AGENT)
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("SentInvitations", fields: [invitedById], references: [id])

  @@index([email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model WorkspaceJoinCode {
  id             String     @id @default(cuid())
  organizationId String
  joinId         String     @unique
  codeHash       String
  role           MemberRole @default(AGENT)
  createdById    String
  consumedById   String?
  consumedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, consumedAt, expiresAt])
}

// ─── Bots ─────────────────────────────────────────────────────────────────────

model Bot {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  primaryChannel BotPrimaryChannel @default(TELEGRAM)
  telegramToken  String?  @unique
  telegramUsername String?
  webWidgetEnabled Boolean @default(false)
  webWidgetKey   String?  @unique
  webWidgetAllowedDomains String[] @default([])
  webhookSet     Boolean  @default(false)
  webhookSecret  String?  // Used to verify incoming Telegram webhook requests
  isActive       Boolean  @default(true)
  aiConfig       Json     @default("{}")
  routeToRoles   String[] @default(["AGENT"]) // roles the AI may auto-assign escalations to
  template       BotTemplate @default(GENERAL)
  capabilities   Json     @default("{}")
  actionForwardingEnabled Boolean @default(false)

  // ── Commerce ──────────────────────────────────────────────────────────────
  commerceStoreId String?

  // ── Email channel ─────────────────────────────────────────────────────────
  // Option B: Zuti-hosted address (auto-generated, zero user DNS setup)
  emailEnabled          Boolean  @default(false)
  emailAddress          String?  @unique  // e.g. bot-{widgetKey}@mail.zuti.bords.app
  // Option A: custom domain (user configures MX record, added later)
  customEmailDomain     String?            // e.g. support.their-company.com
  customEmailAddress    String?            // e.g. support@their-company.com
  customEmailVerified   Boolean  @default(false)

  // ── WhatsApp channel (Meta Cloud API) ───────────────────────────────────
  whatsappEnabled           Boolean  @default(false)
  whatsappProvider          WhatsAppProvider?
  whatsappIntegrationMode   WhatsAppIntegrationMode?
  whatsappChannelIdentifier String?  @unique
  whatsappPhoneNumber       String?
  whatsappDisplayName       String?
  whatsappVerifyToken       String?
  whatsappConfig            Json     @default("{}")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commerceStore  CommerceStore? @relation(fields: [commerceStoreId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  contactPolicies ContactPolicy[]
  actionTasks ActionTask[]
  leads Lead[]
  bookings Booking[]
  salesOrders SalesOrder[]
  technicalIssues TechnicalIssue[]

  @@unique([organizationId, name])
}

enum BotTemplate {
  GENERAL
  SALES
  SUPPORT
  BOOKING
  TECHNICAL
  ECOMMERCE
}

enum BotPrimaryChannel {
  TELEGRAM
  WEB_WIDGET
  EMAIL
  WHATSAPP
}

enum WhatsAppProvider {
  META
  TWILIO
}

enum WhatsAppIntegrationMode {
  META_EMBEDDED_SIGNUP
  META_MANUAL
  TWILIO
}

// ─── Knowledge Base ───────────────────────────────────────────────────────────

model KnowledgeFile {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  type           KnowledgeFileType
  url            String?
  storageKey     String?
  status         ProcessingStatus  @default(PENDING)
  chunkCount     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  knowledgeFileId String
  content         String
  metadata        Json     @default("{}")
  qdrantPointId   String?
  createdAt       DateTime @default(now())

  file            KnowledgeFile @relation(fields: [knowledgeFileId], references: [id], onDelete: Cascade)
}

model KnowledgeSuggestion {
  id             String                    @id @default(cuid())
  organizationId String
  conversationId String?
  threadId       String?
  title          String
  content        String
  sourceQuestion String?
  sourceAnswer   String?
  status         KnowledgeSuggestionStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  thread         EscalationThread?         @relation(fields: [threadId], references: [id], onDelete: SetNull)
  reviewedBy     User?                     @relation("ReviewedKnowledgeSuggestions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([threadId])
}

enum KnowledgeFileType {
  PDF
  DOCX
  TXT
  URL
  FAQ
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum KnowledgeSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

// ─── Conversations ────────────────────────────────────────────────────────────

model Conversation {
  id               String             @id @default(cuid())
  organizationId   String
  botId            String
  channel          ConversationChannel @default(WIDGET)
  telegramChatId   String?
  customerName     String?
  customerUsername String?
  widgetVisitorId  String?
  widgetVisitorEmail String?
  // Email channel fields
  customerEmail    String?   // sender address (email channel)
  emailThreadId    String?   // original Message-ID for In-Reply-To threading
  emailSubject     String?   // subject line
  // WhatsApp channel fields
  whatsappUserId   String?
  whatsappPhoneNumber String?
  whatsappProfileName String?
  status           ConversationStatus @default(OPEN)
  mode             ConversationMode   @default(AI)
  assignedAgentId  String?
  priority         Priority           @default(NORMAL)
  tags             String[]
  metadata         Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastMessageAt    DateTime?
  // Customer hub: the unified person this conversation belongs to (resolved from channel anchors).
  customerId       String?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot              Bot          @relation(fields: [botId], references: [id])
  assignedAgent    User?        @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages         Message[]
  escalations      Escalation[]
  escalationThreads EscalationThread[]
  knowledgeSuggestions KnowledgeSuggestion[]
  knowledgeGaps KnowledgeGap[]
  actionTasks ActionTask[]

  @@index([botId, telegramChatId])
  @@index([botId, widgetVisitorId])
  @@index([botId, customerEmail])
  @@index([botId, whatsappUserId])
  @@index([botId, whatsappPhoneNumber])
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@index([organizationId, assignedAgentId, lastMessageAt(sort: Desc)])
  @@index([organizationId, assignedAgentId, mode, status])
  @@index([customerId])
}

enum ConversationChannel {
  WIDGET
  TELEGRAM
  EMAIL
  WHATSAPP
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  telegramMsgId  Int?
  whatsappMsgId  String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceForActionTasks ActionTask[]
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, role, createdAt(sort: Desc)])
}

model MessageAttachment {
  id          String         @id @default(cuid())
  messageId   String
  kind        AttachmentKind
  sourceRef   String?
  url         String?
  storageKey  String?
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  durationSec Int?
  caption     String?
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())

  message     Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, kind])
  @@index([messageId, createdAt(sort: Desc)])
}

enum AttachmentKind {
  IMAGE
  AUDIO
  VOICE
  VIDEO
  DOCUMENT
  FILE
  OTHER
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ESCALATED
}

enum ConversationMode {
  AI
  HUMAN
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  AGENT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─── Action Forwarding and Internal Storage ─────────────────────────────────

model ContactEndpoint {
  id             String   @id @default(cuid())
  orgId          String
  label          String
  channel        ContactChannel
  destination    String
  userId         String?
  isActive       Boolean  @default(true)
  isPrimary      Boolean  @default(false)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policies       ContactPolicy[]
  deliveries     ActionDelivery[]
  assignedActionTasks ActionTask[] @relation("AssignedActionEndpoint")

  @@index([orgId, isActive, channel])
  @@index([orgId, userId, isActive])
}

model ContactPolicy {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String?
  name                  String
  scope                 ContactPolicyScope @default(ORGANIZATION)
  isDefault             Boolean  @default(false)
  endpointId            String?
  rules                 Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot?         @relation(fields: [botId], references: [id], onDelete: Cascade)
  endpoint              ContactEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  routedActionTasks     ActionTask[]

  @@index([orgId, scope, isDefault])
  @@index([orgId, botId])
}

enum ContactPolicyScope {
  ORGANIZATION
  BOT
}

enum ContactChannel {
  TELEGRAM
  EMAIL
  WHATSAPP
}

model ActionTask {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  conversationId        String?
  sourceMessageId       String?
  actionType            ActionType
  status                ActionTaskStatus @default(DETECTED)
  priority              Priority @default(NORMAL)
  summary               String
  payload               Json     @default("{}")
  confidence            Float?
  dedupeKey             String?
  routedPolicyId        String?
  assignedEndpointId    String?
  acknowledgedAt        DateTime?
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation          Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage         Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  routedPolicy          ContactPolicy? @relation(fields: [routedPolicyId], references: [id], onDelete: SetNull)
  assignedEndpoint      ContactEndpoint? @relation("AssignedActionEndpoint", fields: [assignedEndpointId], references: [id], onDelete: SetNull)
  deliveries            ActionDelivery[]
  lead                  Lead?
  booking               Booking?
  salesOrder            SalesOrder?
  technicalIssue        TechnicalIssue?

  @@unique([orgId, dedupeKey])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, actionType, createdAt(sort: Desc)])
  @@index([orgId, assignedEndpointId, status, createdAt(sort: Desc)])
  // Hot path: the agentic order flow looks up the active task for a single conversation
  // (activeConversationTask in action-forwarding). All other indexes lead with orgId, so that
  // lookup scanned the whole org's tasks; a conversation-led index keeps it a tight seek.
  @@index([conversationId, actionType, createdAt(sort: Desc)])
}

enum ActionType {
  MEETING_REQUEST
  CONSULTATION_REQUEST
  SALES_ORDER_REQUEST
  OWNER_ATTENTION_NEEDED
  TECHNICAL_ISSUE
  REGISTRATION_REQUEST
}

enum ActionTaskStatus {
  DETECTED
  PENDING_CONFIRMATION
  QUEUED
  ROUTED
  SENT
  DELIVERED
  ACKNOWLEDGED
  COMPLETED
  FAILED
  CONFIGURATION_NEEDED
}

model ActionDelivery {
  id                    String   @id @default(cuid())
  actionTaskId          String
  orgId                 String
  endpointId            String?
  channel               ContactChannel
  status                ActionDeliveryStatus @default(QUEUED)
  attempt               Int      @default(1)
  providerMessageId     String?
  errorCode             String?
  errorMessage          String?
  requestPayload        Json     @default("{}")
  responsePayload       Json     @default("{}")
  nextRetryAt           DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  acknowledgedAt        DateTime?
  createdAt             DateTime @default(now())

  actionTask            ActionTask @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint              ContactEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([actionTaskId, attempt])
  @@index([orgId, channel, status])
}

enum ActionDeliveryStatus {
  QUEUED
  SENT_TO_CHANNEL
  SENT
  DELIVERED
  FAILED
  RETRYING
  ACKNOWLEDGED
}

model Lead {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  fullName              String?
  email                 String?
  phone                 String?
  interest              String?
  budget                String?
  notes                 String?
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, email])
}

model Booking {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  preferredDatetime      String?
  status                BookingStatus @default(REQUESTED)
  notes                 String?
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customerId            String?
  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)
  customer              Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, customerEmail])
  @@index([customerId])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED
}

model SalesOrder {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  product               String?
  quantity              Int?
  unitPriceMinor        Int?
  commerceOrderId       String?  @unique
  notes                 String?
  status                String   @default("NEW")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  customerId            String?
  organization          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask    @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)
  commerceOrder         CommerceOrder? @relation(fields: [commerceOrderId], references: [id], onDelete: SetNull)
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, customerEmail])
  @@index([customerId])
}

model TechnicalIssue {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  reporterName          String?
  reporterEmail         String?
  reporterPhone         String?
  issueCategory         String?
  severity              String?
  summary               String?
  details               String?
  status                String   @default("OPEN")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([orgId, severity, status, createdAt(sort: Desc)])
  @@index([orgId, reporterEmail])
}

// ─── Escalations ─────────────────────────────────────────────────────────────

model Escalation {
  id             String          @id @default(cuid())
  conversationId String
  reason         String?
  triggeredBy    EscalationTrigger
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  thread         EscalationThread?
}

enum EscalationTrigger {
  USER_REQUEST
  LOW_CONFIDENCE
  KEYWORD
  AGENT_MANUAL
}

// ─── Integrations ─────────────────────────────────────────────────────────────

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  config         Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─── Commerce ───────────────────────────────────────────────────────────────

model CommerceStore {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  currency       CommerceCurrency @default(NGN)
  isActive       Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bots           Bot[]
  locations      CommerceLocation[]
  products       CommerceProduct[]
  orders         CommerceOrder[]

  @@index([organizationId, isActive])
}

model CommerceLocation {
  id             String   @id @default(cuid())
  storeId        String
  name           String
  code           String
  address        Json     @default("{}")
  isActive       Boolean  @default(true)
  priority       Int      @default(100)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store          CommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryLevels CommerceInventoryLevel[]
  orderItems     CommerceOrderItem[]

  @@unique([storeId, code])
  @@index([storeId, isActive, priority])
}

model CommerceProduct {
  id             String   @id @default(cuid())
  storeId        String
  title          String
  slug           String
  description    String?
  category       String?
  imageUrl       String?
  tags           String[] @default([])
  isActive       Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store          CommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variants       CommerceVariant[]

  @@unique([storeId, slug])
  @@index([storeId, isActive, createdAt(sort: Desc)])
}

model CommerceVariant {
  id             String   @id @default(cuid())
  productId      String
  sku            String
  title          String?
  attributes     Json     @default("{}")
  priceMinor     Int
  currency       CommerceCurrency
  isActive       Boolean  @default(true)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        CommerceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLevels CommerceInventoryLevel[]
  orderItems     CommerceOrderItem[]

  @@unique([productId, sku])
  @@index([productId, isActive])
}

model CommerceInventoryLevel {
  id             String   @id @default(cuid())
  variantId      String
  locationId     String
  onHand         Int      @default(0)
  reserved       Int      @default(0)
  reorderPoint   Int      @default(0)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variant        CommerceVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location       CommerceLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([locationId])
}

enum CommerceCurrency {
  NGN
  USD
}

model CommerceOrder {
  id              String   @id @default(cuid())
  organizationId  String
  storeId         String
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  deliveryAddress String?
  notes           String?
  currency        CommerceCurrency
  subtotalMinor   Int      @default(0)
  totalMinor      Int      @default(0)
  status          CommerceOrderStatus @default(DRAFT)
  paymentStatus   CommercePaymentStatus @default(PENDING)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customerId      String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store           CommerceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items           CommerceOrderItem[]
  payments        CommercePayment[]
  salesOrder      SalesOrder?

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@index([customerId])
}

model CommerceOrderItem {
  id              String   @id @default(cuid())
  orderId         String
  variantId       String?
  lineDescription String?
  locationId      String?
  quantity        Int      @default(1)
  unitPriceMinor  Int
  lineTotalMinor  Int
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order           CommerceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         CommerceVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location        CommerceLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@index([locationId])
}

model CommercePayment {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  provider       CommercePaymentProvider @default(PAYSTACK)
  reference      String   @unique
  amountMinor    Int
  currency       CommerceCurrency
  status         CommercePaymentStatus @default(PENDING)
  authorizationUrl String?
  paidAt         DateTime?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([orderId, status, createdAt(sort: Desc)])
}

enum CommerceOrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
  FAILED
}

enum CommercePaymentProvider {
  PAYSTACK
}

enum CommercePaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Billing {
  id             String      @id @default(cuid())
  organizationId String      @unique
  plan           BillingPlan @default(STARTER)
  messageCount   Int         @default(0)
  messageLimit   Int         @default(1000)
  creditBalanceUnits Int     @default(0)
  committedMonthlyCreditsUnits Int @default(0)
  commitmentRenewsAt DateTime?
  renewsAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries  CreditLedger[]
  transactions   BillingTransaction[]
}

model CreditLedger {
  id             String           @id @default(cuid())
  organizationId String
  billingId      String
  transactionId  String?
  type           CreditLedgerType
  creditsDeltaUnits Int           @default(0)
  balanceAfterUnits Int           @default(0)
  description    String?
  metadata       Json             @default("{}")
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billing        Billing          @relation(fields: [billingId], references: [id], onDelete: Cascade)
  transaction    BillingTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([billingId, createdAt(sort: Desc)])
}

model BillingTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  billingId      String
  initiatedById  String?
  idempotencyKey String?                  @unique
  provider       PaymentProvider          @default(PAYSTACK)
  reference      String                   @unique
  kind           BillingTransactionKind
  status         BillingTransactionStatus @default(PENDING)
  amountMinor    Int
  currency       String
  creditsUnits   Int              @default(0)
  metadata       Json                     @default("{}")
  paidAt         DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billing        Billing                  @relation(fields: [billingId], references: [id], onDelete: Cascade)
  initiatedBy    User?                    @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  ledgerEntries  CreditLedger[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, initiatedById, kind, createdAt(sort: Desc)])
}

enum BillingPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum CreditLedgerType {
  GRANT
  PURCHASE
  USAGE
  ADJUSTMENT
  REFUND
  COMMITMENT_ALLOCATION
}

enum PaymentProvider {
  PAYSTACK
}

enum BillingTransactionKind {
  CREDIT_PACK
  COMMITMENT
}

enum BillingTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id           String   @id @default(cuid())
  orgId        String
  /// null = visible to all OWNER/ADMIN of the org; set = personal to that user
  targetUserId String?
  type         String
  title        String
  body         String
  metadata     Json     @default("{}")
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, isRead])
  @@index([orgId, targetUserId, isRead, createdAt(sort: Desc)])
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  actorName  String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, targetType, targetId, action, createdAt(sort: Desc)])
}

// ─── Canned Responses ─────────────────────────────────────────────────────────

model CannedResponse {
  id             String   @id @default(cuid())
  organizationId String
  shortcut       String   // trigger word, e.g. "refund"
  title          String   // display label, e.g. "Refund policy"
  content        String   // full response text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

// ─── Team Chat ───────────────────────────────────────────────────────────────

model TeamChatMessage {
  id             String   @id @default(cuid())
  organizationId String
  senderId       String
  content        String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([senderId])
}

model EscalationThread {
  id                String                 @id @default(cuid())
  organizationId    String
  conversationId    String?
  escalationId      String?                @unique
  teamChatMessageId String?
  assignedUserId    String?
  topic             String?
  question          String
  status            EscalationThreadStatus @default(OPEN)
  duplicateCount    Int                    @default(1)
  metadata          Json                   @default("{}")
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation      Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  escalation        Escalation?            @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  assignedUser      User?                  @relation("AssignedEscalationThread", fields: [assignedUserId], references: [id], onDelete: SetNull)
  replies           EscalationThreadReply[]
  knowledgeSuggestions KnowledgeSuggestion[]
  knowledgeGaps     KnowledgeGap[]

  @@index([organizationId, status, createdAt])
  @@index([assignedUserId, status])
  @@index([conversationId])
}

model KnowledgeGap {
  id             String             @id @default(cuid())
  organizationId String
  conversationId String?
  threadId       String?
  topicKey       String
  topic          String?
  question       String
  status         KnowledgeGapStatus @default(OPEN)
  seenCount      Int                @default(1)
  lastSeenAt     DateTime           @default(now())
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  thread         EscalationThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@unique([organizationId, topicKey])
  @@index([organizationId, status, lastSeenAt])
  @@index([threadId])
}

enum KnowledgeGapStatus {
  OPEN
  ANSWERED
  RESOLVED
  DISMISSED
}

model EscalationThreadReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  thread    EscalationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

enum EscalationThreadStatus {
  OPEN
  ANSWERED
  RESOLVED
  DUPLICATE
}

model AiUsageEvent {
  id               String      @id @default(cuid())
  organizationId   String
  botId            String?
  conversationId   String?
  usageType        AiUsageType
  provider         String?
  model            String?
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  metadata         Json        @default("{}")
  createdAt        DateTime    @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, usageType, createdAt])
  @@index([conversationId])
}

enum AiUsageType {
  CUSTOMER_REPLY
  CSAT_CLASSIFICATION
  ESCALATION_ANALYSIS
  KNOWLEDGE_SUGGESTION
  INTERNAL_ASSISTANT
  SUMMARIZATION
  MEDIA_TRANSCRIPTION
  MEDIA_VISION
}

// ─── Registrations ────────────────────────────────────────────────────────────

model RegistrationProduct {
  id                  String    @id @default(cuid())
  orgId               String
  botId               String?
  name                String
  description         String?
  eventDate           DateTime?
  capacity            Int?
  isFree              Boolean   @default(true)
  priceMinor          Int?      // price in lowest denomination (e.g. kobo)
  currency            String    @default("NGN")
  requiresApproval    Boolean   @default(false)
  confirmationMessage String?
  fields              Json      @default("[]") // [{key, label, type, required}]
  isActive            Boolean   @default(true)
  // When false (default), a given email can hold only one active registration for this event.
  allowDuplicateRegistrations Boolean @default(false)
  // Public event page (shareable + brandable). slug is GLOBALLY unique for clean URLs (/e/<slug>);
  // isPublic gates whether the page is live (separate from isActive). priceMinor above is the legacy
  // single-price fallback used only when the event has no ticketTypes.
  slug                String?   @unique
  isPublic            Boolean   @default(false)
  bannerUrl           String?
  flierUrl            String?
  venue               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization        Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries             RegistrationEntry[]
  ticketTypes         RegistrationTicketType[]

  @@index([orgId, isActive])
  @@index([botId, isActive])
}

/// A ticket tier for an event (e.g. Regular, VIP). Price lives HERE and is authoritative — never
/// client-typed — mirroring how CommerceVariant owns price, which kills the mistyped-price bug class.
/// An event with no ticketTypes falls back to the legacy single price on RegistrationProduct.
model RegistrationTicketType {
  id           String   @id @default(cuid())
  productId    String
  name         String
  description  String?
  priceMinor   Int?     // null / 0 = free tier
  currency     String   @default("NGN")
  capacity     Int?     // per-tier cap; null = bounded only by the event's overall capacity
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      RegistrationProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  entries      RegistrationEntry[]

  @@index([productId, isActive, sortOrder])
}

model RegistrationEntry {
  id                  String                  @id @default(cuid())
  productId           String
  // The chosen tier (null for legacy single-price events). Price is read from the tier, never the client.
  ticketTypeId        String?
  orgId               String
  botId               String?
  conversationId      String?
  actionTaskId        String?
  customerName        String?
  customerEmail       String?
  collectedFields     Json                    @default("{}")
  status              RegistrationEntryStatus @default(PENDING_PAYMENT)
  // Number of tickets/spots this entry represents. Capacity consumes the sum of quantities.
  quantity            Int                     @default(1)
  // Total amount charged for this entry (unit priceMinor × quantity), captured at payment
  // init so the webhook/callback can verify against the real charged amount.
  amountMinor         Int?
  paystackReference   String?
  paystackAccessCode  String?
  paidAt              DateTime?
  // Admission: opaque code embedded in the ticket QR; checkedInAt is set once when scanned at entry
  // (single-use — a second scan is rejected as "already admitted").
  checkInCode         String?                 @unique
  checkedInAt         DateTime?
  // Groups the individual tickets bought in one purchase (each ticket is its own entry + QR, but
  // they share one payment). Null for standalone/legacy single registrations.
  purchaseGroupId     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  customerId          String?
  product             RegistrationProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ticketType          RegistrationTicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  organization        Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer            Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([ticketTypeId, status])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([paystackReference])
  @@index([productId, customerEmail, status])
  @@index([purchaseGroupId])
  @@index([customerId])
}

enum RegistrationEntryStatus {
  PENDING_PAYMENT
  AWAITING_APPROVAL
  CONFIRMED
  CANCELLED
}

// ── Customer Hub ──────────────────────────────────────────────────────────────
// Unified per-org record of a person the business has had a real, first-party interaction with.
// "Customer" is a loose umbrella; lifecycleStage carries lead → engaged → customer. Identity is
// resolved via CustomerIdentifier anchors (channels the person controls), never typed attributes.
// See CUSTOMER_HUB_PLAN.md.
model Customer {
  id                 String   @id @default(cuid())
  orgId              String
  displayName        String?
  primaryEmail       String?  // best-known contact email; NOT authoritative identity
  primaryPhone       String?
  lifecycleStage     CustomerLifecycle @default(LEAD)
  // CRM layer (writeable by humans + AI-enrichment)
  tags               String[] @default([])
  notes              String?
  // Consent / compliance (marketing sends MUST honor these)
  emailOptOut        Boolean  @default(false)
  marketingConsentAt DateTime? // opt-in timestamp; null = no marketing consent
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  identifiers        CustomerIdentifier[]
  conversations      Conversation[]
  salesOrders        SalesOrder[]
  bookings           Booking[]
  commerceOrders     CommerceOrder[]
  registrationEntries RegistrationEntry[]

  @@index([orgId, lifecycleStage, lastSeenAt(sort: Desc)])
  @@index([orgId, primaryEmail])
  @@index([orgId, lastSeenAt(sort: Desc)])
}

// An identifier the person is known by. isAnchor = a channel of contact they demonstrably control
// (safe to auto-attach/auto-merge on); isAnchor=false = a typed attribute (contact data only, never
// drives automatic merges). Unique per (org, type, value) so an identifier maps to exactly one person.
model CustomerIdentifier {
  id         String   @id @default(cuid())
  customerId String
  orgId      String
  type       IdentifierType
  value      String   // normalized (lowercased email, E.164 phone, raw chat/user id)
  isAnchor   Boolean  @default(true)
  verifiedAt DateTime?
  source     String?  // where captured: bot id, order id, "web-purchase", etc.
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([orgId, type, value])
  @@index([customerId])
}

enum CustomerLifecycle {
  LEAD
  ENGAGED
  CUSTOMER
}

enum IdentifierType {
  TELEGRAM_CHAT
  WHATSAPP_PHONE
  EMAIL
  PHONE
  WIDGET_SESSION
}
