generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  emailVerifiedAt DateTime?
  emailVerificationTokenHash String?
  emailVerificationSentAt DateTime?
  passwordResetTokenHash String?
  passwordResetSentAt DateTime?
  name          String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   OrganizationMember[]
  assignedConversations Conversation[] @relation("AssignedAgent")
  teamChatMessages TeamChatMessage[]
  sentInvitations Invitation[] @relation("SentInvitations")
  assignedEscalationThreads EscalationThread[] @relation("AssignedEscalationThread")
  escalationThreadReplies EscalationThreadReply[]
  reviewedKnowledgeSuggestions KnowledgeSuggestion[] @relation("ReviewedKnowledgeSuggestions")
  billingTransactions BillingTransaction[]
}

// ─── Organizations ────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  bots        Bot[]
  knowledgeFiles KnowledgeFile[]
  conversations  Conversation[]
  integrations   Integration[]
  billing        Billing?
  invitations    Invitation[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  cannedResponses CannedResponse[]
  teamChatMessages TeamChatMessage[]
  escalationThreads EscalationThread[]
  knowledgeSuggestions KnowledgeSuggestion[]
  aiUsageEvents AiUsageEvent[]
  knowledgeGaps KnowledgeGap[]
  creditLedgerEntries CreditLedger[]
  billingTransactions BillingTransaction[]
  contactEndpoints ContactEndpoint[]
  contactPolicies ContactPolicy[]
  actionTasks ActionTask[]
  actionDeliveries ActionDelivery[]
  leads Lead[]
  bookings Booking[]
  salesOrders SalesOrder[]
  technicalIssues TechnicalIssue[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(AGENT)
  createdAt      DateTime @default(now())

  // ── Agent routing metadata ────────────────────────────────────────────────
  // Topic tags this agent handles, e.g. ["billing", "technical", "returns"]
  specializations          String[]  @default([])
  // Agent is accepting new conversations
  isAvailable              Boolean   @default(true)
  // Hard cap on simultaneous open conversations
  maxConcurrentConversations Int     @default(10)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role, isAvailable])
}

enum MemberRole {
  OWNER
  ADMIN
  AGENT
}

// ─── Invitations ─────────────────────────────────────────────────────────────

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  token          String           @unique
  role           MemberRole       @default(AGENT)
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("SentInvitations", fields: [invitedById], references: [id])

  @@index([email, status])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ─── Bots ─────────────────────────────────────────────────────────────────────

model Bot {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  primaryChannel BotPrimaryChannel @default(TELEGRAM)
  telegramToken  String?  @unique
  telegramUsername String?
  webWidgetEnabled Boolean @default(false)
  webWidgetKey   String?  @unique
  webWidgetAllowedDomains String[] @default([])
  webhookSet     Boolean  @default(false)
  webhookSecret  String?  // Used to verify incoming Telegram webhook requests
  isActive       Boolean  @default(true)
  aiConfig       Json     @default("{}")
  routeToRoles   String[] @default(["AGENT"]) // roles the AI may auto-assign escalations to
  template       BotTemplate @default(GENERAL)
  capabilities   Json     @default("{}")
  actionForwardingEnabled Boolean @default(false)

  // ── Email channel ─────────────────────────────────────────────────────────
  // Option B: Zuti-hosted address (auto-generated, zero user DNS setup)
  emailEnabled          Boolean  @default(false)
  emailAddress          String?  @unique  // e.g. bot-{widgetKey}@mail.zuti.bords.app
  // Option A: custom domain (user configures MX record, added later)
  customEmailDomain     String?            // e.g. support.their-company.com
  customEmailAddress    String?            // e.g. support@their-company.com
  customEmailVerified   Boolean  @default(false)

  // ── WhatsApp channel (Meta Cloud API) ───────────────────────────────────
  whatsappEnabled           Boolean  @default(false)
  whatsappProvider          WhatsAppProvider?
  whatsappIntegrationMode   WhatsAppIntegrationMode?
  whatsappChannelIdentifier String?  @unique
  whatsappPhoneNumber       String?
  whatsappDisplayName       String?
  whatsappVerifyToken       String?
  whatsappConfig            Json     @default("{}")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  contactPolicies ContactPolicy[]
  actionTasks ActionTask[]
  leads Lead[]
  bookings Booking[]
  salesOrders SalesOrder[]
  technicalIssues TechnicalIssue[]
}

enum BotTemplate {
  GENERAL
  SALES
  SUPPORT
  BOOKING
  TECHNICAL
}

enum BotPrimaryChannel {
  TELEGRAM
  WEB_WIDGET
  EMAIL
  WHATSAPP
}

enum WhatsAppProvider {
  META
  TWILIO
}

enum WhatsAppIntegrationMode {
  META_EMBEDDED_SIGNUP
  META_MANUAL
  TWILIO
}

// ─── Knowledge Base ───────────────────────────────────────────────────────────

model KnowledgeFile {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  type           KnowledgeFileType
  url            String?
  storageKey     String?
  status         ProcessingStatus  @default(PENDING)
  chunkCount     Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks         KnowledgeChunk[]
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  knowledgeFileId String
  content         String
  metadata        Json     @default("{}")
  qdrantPointId   String?
  createdAt       DateTime @default(now())

  file            KnowledgeFile @relation(fields: [knowledgeFileId], references: [id], onDelete: Cascade)
}

model KnowledgeSuggestion {
  id             String                    @id @default(cuid())
  organizationId String
  conversationId String?
  threadId       String?
  title          String
  content        String
  sourceQuestion String?
  sourceAnswer   String?
  status         KnowledgeSuggestionStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation?             @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  thread         EscalationThread?         @relation(fields: [threadId], references: [id], onDelete: SetNull)
  reviewedBy     User?                     @relation("ReviewedKnowledgeSuggestions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([threadId])
}

enum KnowledgeFileType {
  PDF
  DOCX
  TXT
  URL
  FAQ
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum KnowledgeSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  MERGED
}

// ─── Conversations ────────────────────────────────────────────────────────────

model Conversation {
  id               String             @id @default(cuid())
  organizationId   String
  botId            String
  channel          ConversationChannel @default(WIDGET)
  telegramChatId   String?
  customerName     String?
  customerUsername String?
  widgetVisitorId  String?
  widgetVisitorEmail String?
  // Email channel fields
  customerEmail    String?   // sender address (email channel)
  emailThreadId    String?   // original Message-ID for In-Reply-To threading
  emailSubject     String?   // subject line
  // WhatsApp channel fields
  whatsappUserId   String?
  whatsappPhoneNumber String?
  whatsappProfileName String?
  status           ConversationStatus @default(OPEN)
  mode             ConversationMode   @default(AI)
  assignedAgentId  String?
  priority         Priority           @default(NORMAL)
  tags             String[]
  metadata         Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  lastMessageAt    DateTime?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot              Bot          @relation(fields: [botId], references: [id])
  assignedAgent    User?        @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  messages         Message[]
  escalations      Escalation[]
  escalationThreads EscalationThread[]
  knowledgeSuggestions KnowledgeSuggestion[]
  knowledgeGaps KnowledgeGap[]
  actionTasks ActionTask[]

  @@index([botId, telegramChatId])
  @@index([botId, widgetVisitorId])
  @@index([botId, customerEmail])
  @@index([botId, whatsappUserId])
  @@index([botId, whatsappPhoneNumber])
  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, status, lastMessageAt(sort: Desc)])
  @@index([organizationId, assignedAgentId, lastMessageAt(sort: Desc)])
  @@index([organizationId, assignedAgentId, mode, status])
}

enum ConversationChannel {
  WIDGET
  TELEGRAM
  EMAIL
  WHATSAPP
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  telegramMsgId  Int?
  whatsappMsgId  String?
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceForActionTasks ActionTask[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, role, createdAt(sort: Desc)])
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  ESCALATED
}

enum ConversationMode {
  AI
  HUMAN
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  AGENT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─── Action Forwarding and Internal Storage ─────────────────────────────────

model ContactEndpoint {
  id             String   @id @default(cuid())
  orgId          String
  label          String
  channel        ContactChannel
  destination    String
  userId         String?
  isActive       Boolean  @default(true)
  isPrimary      Boolean  @default(false)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  policies       ContactPolicy[]
  deliveries     ActionDelivery[]
  assignedActionTasks ActionTask[] @relation("AssignedActionEndpoint")

  @@index([orgId, isActive, channel])
  @@index([orgId, userId, isActive])
}

model ContactPolicy {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String?
  name                  String
  scope                 ContactPolicyScope @default(ORGANIZATION)
  isDefault             Boolean  @default(false)
  endpointId            String?
  rules                 Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot?         @relation(fields: [botId], references: [id], onDelete: Cascade)
  endpoint              ContactEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  routedActionTasks     ActionTask[]

  @@index([orgId, scope, isDefault])
  @@index([orgId, botId])
}

enum ContactPolicyScope {
  ORGANIZATION
  BOT
}

enum ContactChannel {
  TELEGRAM
  EMAIL
  WHATSAPP
}

model ActionTask {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  conversationId        String?
  sourceMessageId       String?
  actionType            ActionType
  status                ActionTaskStatus @default(DETECTED)
  priority              Priority @default(NORMAL)
  summary               String
  payload               Json     @default("{}")
  confidence            Float?
  dedupeKey             String?
  routedPolicyId        String?
  assignedEndpointId    String?
  acknowledgedAt        DateTime?
  completedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversation          Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage         Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  routedPolicy          ContactPolicy? @relation(fields: [routedPolicyId], references: [id], onDelete: SetNull)
  assignedEndpoint      ContactEndpoint? @relation("AssignedActionEndpoint", fields: [assignedEndpointId], references: [id], onDelete: SetNull)
  deliveries            ActionDelivery[]
  lead                  Lead?
  booking               Booking?
  salesOrder            SalesOrder?
  technicalIssue        TechnicalIssue?

  @@unique([orgId, dedupeKey])
  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, actionType, createdAt(sort: Desc)])
  @@index([orgId, assignedEndpointId, status, createdAt(sort: Desc)])
}

enum ActionType {
  MEETING_REQUEST
  CONSULTATION_REQUEST
  SALES_ORDER_REQUEST
  OWNER_ATTENTION_NEEDED
  TECHNICAL_ISSUE
}

enum ActionTaskStatus {
  DETECTED
  PENDING_CONFIRMATION
  QUEUED
  ROUTED
  SENT
  DELIVERED
  ACKNOWLEDGED
  COMPLETED
  FAILED
  CONFIGURATION_NEEDED
}

model ActionDelivery {
  id                    String   @id @default(cuid())
  actionTaskId          String
  orgId                 String
  endpointId            String?
  channel               ContactChannel
  status                ActionDeliveryStatus @default(QUEUED)
  attempt               Int      @default(1)
  providerMessageId     String?
  errorCode             String?
  errorMessage          String?
  requestPayload        Json     @default("{}")
  responsePayload       Json     @default("{}")
  nextRetryAt           DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  acknowledgedAt        DateTime?
  createdAt             DateTime @default(now())

  actionTask            ActionTask @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  endpoint              ContactEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([actionTaskId, attempt])
  @@index([orgId, channel, status])
}

enum ActionDeliveryStatus {
  QUEUED
  SENT_TO_CHANNEL
  SENT
  DELIVERED
  FAILED
  RETRYING
  ACKNOWLEDGED
}

model Lead {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  fullName              String?
  email                 String?
  phone                 String?
  interest              String?
  budget                String?
  notes                 String?
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, email])
}

model Booking {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  preferredDatetime      String?
  status                BookingStatus @default(REQUESTED)
  notes                 String?
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, customerEmail])
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  CANCELLED
}

model SalesOrder {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  product               String?
  quantity              Int?
  notes                 String?
  status                String   @default("NEW")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt(sort: Desc)])
  @@index([orgId, customerEmail])
}

model TechnicalIssue {
  id                    String   @id @default(cuid())
  orgId                 String
  botId                 String
  actionTaskId          String   @unique
  reporterName          String?
  reporterEmail         String?
  reporterPhone         String?
  issueCategory         String?
  severity              String?
  summary               String?
  details               String?
  status                String   @default("OPEN")
  metadata              Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  bot                   Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  actionTask            ActionTask   @relation(fields: [actionTaskId], references: [id], onDelete: Cascade)

  @@index([orgId, severity, status, createdAt(sort: Desc)])
  @@index([orgId, reporterEmail])
}

// ─── Escalations ─────────────────────────────────────────────────────────────

model Escalation {
  id             String          @id @default(cuid())
  conversationId String
  reason         String?
  triggeredBy    EscalationTrigger
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  thread         EscalationThread?
}

enum EscalationTrigger {
  USER_REQUEST
  LOW_CONFIDENCE
  KEYWORD
  AGENT_MANUAL
}

// ─── Integrations ─────────────────────────────────────────────────────────────

model Integration {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  config         Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ─── Billing ──────────────────────────────────────────────────────────────────

model Billing {
  id             String      @id @default(cuid())
  organizationId String      @unique
  plan           BillingPlan @default(STARTER)
  messageCount   Int         @default(0)
  messageLimit   Int         @default(1000)
  creditBalanceUnits Int     @default(0)
  committedMonthlyCreditsUnits Int @default(0)
  commitmentRenewsAt DateTime?
  renewsAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries  CreditLedger[]
  transactions   BillingTransaction[]
}

model CreditLedger {
  id             String           @id @default(cuid())
  organizationId String
  billingId      String
  transactionId  String?
  type           CreditLedgerType
  creditsDeltaUnits Int           @default(0)
  balanceAfterUnits Int           @default(0)
  description    String?
  metadata       Json             @default("{}")
  idempotencyKey String?          @unique
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billing        Billing          @relation(fields: [billingId], references: [id], onDelete: Cascade)
  transaction    BillingTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([billingId, createdAt(sort: Desc)])
}

model BillingTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  billingId      String
  initiatedById  String?
  idempotencyKey String?                  @unique
  provider       PaymentProvider          @default(PAYSTACK)
  reference      String                   @unique
  kind           BillingTransactionKind
  status         BillingTransactionStatus @default(PENDING)
  amountMinor    Int
  currency       String
  creditsUnits   Int              @default(0)
  metadata       Json                     @default("{}")
  paidAt         DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billing        Billing                  @relation(fields: [billingId], references: [id], onDelete: Cascade)
  initiatedBy    User?                    @relation(fields: [initiatedById], references: [id], onDelete: SetNull)
  ledgerEntries  CreditLedger[]

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, initiatedById, kind, createdAt(sort: Desc)])
}

enum BillingPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum CreditLedgerType {
  GRANT
  PURCHASE
  USAGE
  ADJUSTMENT
  REFUND
  COMMITMENT_ALLOCATION
}

enum PaymentProvider {
  PAYSTACK
}

enum BillingTransactionKind {
  CREDIT_PACK
  COMMITMENT
}

enum BillingTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id           String   @id @default(cuid())
  orgId        String
  /// null = visible to all OWNER/ADMIN of the org; set = personal to that user
  targetUserId String?
  type         String
  title        String
  body         String
  metadata     Json     @default("{}")
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, isRead])
  @@index([orgId, targetUserId, isRead, createdAt(sort: Desc)])
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  actorName  String
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, targetType, targetId, action, createdAt(sort: Desc)])
}

// ─── Canned Responses ─────────────────────────────────────────────────────────

model CannedResponse {
  id             String   @id @default(cuid())
  organizationId String
  shortcut       String   // trigger word, e.g. "refund"
  title          String   // display label, e.g. "Refund policy"
  content        String   // full response text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

// ─── Team Chat ───────────────────────────────────────────────────────────────

model TeamChatMessage {
  id             String   @id @default(cuid())
  organizationId String
  senderId       String
  content        String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([senderId])
}

model EscalationThread {
  id                String                 @id @default(cuid())
  organizationId    String
  conversationId    String?
  escalationId      String?                @unique
  teamChatMessageId String?
  assignedUserId    String?
  topic             String?
  question          String
  status            EscalationThreadStatus @default(OPEN)
  duplicateCount    Int                    @default(1)
  metadata          Json                   @default("{}")
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation      Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  escalation        Escalation?            @relation(fields: [escalationId], references: [id], onDelete: SetNull)
  assignedUser      User?                  @relation("AssignedEscalationThread", fields: [assignedUserId], references: [id], onDelete: SetNull)
  replies           EscalationThreadReply[]
  knowledgeSuggestions KnowledgeSuggestion[]
  knowledgeGaps     KnowledgeGap[]

  @@index([organizationId, status, createdAt])
  @@index([assignedUserId, status])
  @@index([conversationId])
}

model KnowledgeGap {
  id             String             @id @default(cuid())
  organizationId String
  conversationId String?
  threadId       String?
  topicKey       String
  topic          String?
  question       String
  status         KnowledgeGapStatus @default(OPEN)
  seenCount      Int                @default(1)
  lastSeenAt     DateTime           @default(now())
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  thread         EscalationThread?  @relation(fields: [threadId], references: [id], onDelete: SetNull)

  @@unique([organizationId, topicKey])
  @@index([organizationId, status, lastSeenAt])
  @@index([threadId])
}

enum KnowledgeGapStatus {
  OPEN
  ANSWERED
  RESOLVED
  DISMISSED
}

model EscalationThreadReply {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  thread    EscalationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([authorId])
}

enum EscalationThreadStatus {
  OPEN
  ANSWERED
  RESOLVED
  DUPLICATE
}

model AiUsageEvent {
  id               String      @id @default(cuid())
  organizationId   String
  botId            String?
  conversationId   String?
  usageType        AiUsageType
  provider         String?
  model            String?
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  metadata         Json        @default("{}")
  createdAt        DateTime    @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, usageType, createdAt])
  @@index([conversationId])
}

enum AiUsageType {
  CUSTOMER_REPLY
  CSAT_CLASSIFICATION
  ESCALATION_ANALYSIS
  KNOWLEDGE_SUGGESTION
  INTERNAL_ASSISTANT
  SUMMARIZATION
}
