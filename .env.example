# ─── Storage (Supabase Object Storage) ─────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"
SUPABASE_STORAGE_PUBLIC="false"
SUPABASE_STORAGE_PUBLIC_BASE_URL=""
SUPABASE_STORAGE_SIGNED_URL_EXPIRES_SECONDS="604800"

# ─── Media Processing (AI service) ────────────────────────
# Whisper transcription — use Groq (free tier, fast) or OpenAI
# Groq: get key at console.groq.com → API Keys
WHISPER_API_KEY=""                          # Groq key (gsk_...) or OpenAI key
WHISPER_API_BASE_URL="https://api.groq.com/openai/v1"  # or https://api.openai.com/v1
WHISPER_MODEL="whisper-large-v3-turbo"     # Groq model; use whisper-1 for OpenAI
# Legacy — only needed if not using WHISPER_API_KEY above
OPENAI_API_KEY=""
# Vision model for image descriptions via OpenRouter (default: google/gemini-2.0-flash-001)
MEDIA_VISION_MODEL="google/gemini-2.0-flash-001"
# Set to false to disable AI media processing entirely
MEDIA_PROCESSING_ENABLED="true"
# Per-org daily cap for media understanding calls (transcription + vision). 0 = unlimited.
MEDIA_PROCESSING_DAILY_LIMIT="200"

# ─── Internal API Security ────────────────────────────────
# Shared secret between NestJS API and AI service — must match in both.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ─── App ──────────────────────────────────────────────────
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

